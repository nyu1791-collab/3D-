{
  "schema": 1,
  "name": "3D-",
  "kind": "video",
  "setup": [
    [
      "{bootstrap_python}",
      "-m",
      "venv",
      "{repo}/.venv"
    ],
    [
      "{python}",
      "-m",
      "pip",
      "install",
      "-r",
      "requirements.txt"
    ]
  ],
  "tools": [
    "git",
    "ffmpeg",
    "ffprobe"
  ],
  "credential_names": [
    "GEMINI_API_KEY",
    "GOOGLE_CLOUD_PROJECT"
  ],
  "native_entry": "python main.py --help",
  "package_mode": "tiktok",
  "production_execution": "explicit_native_command",
  "shared_runtime": false,
  "recommended_python": "3.12"
}
